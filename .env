# Configuración por defecto (versionada, sin secretos) — muestra pública Ingesar
# Modo demo: la app funciona con datos simulados, sin depender de la base de datos.
# Nota: una variable con el mismo nombre definida en el panel de Vercel tiene prioridad
# sobre este archivo. Para la muestra, NEXT_PUBLIC_DEMO_MODE debe quedar en "true".
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_NAME=Ingesar
